# =============================================
# Zeytun Anketa Bot - Environment Variables
# =============================================
# Bu faylni nusxa oling: cp .env.example .env
# Keyin .env faylini o'z qiymatlari bilan to'ldiring

# --- Telegram Bot ---
BOT_TOKEN=your_telegram_bot_token_here
WEB_APP_URL=https://your-domain-or-tunnel-url.com

# --- Webhook (ixtiyoriy, lokal ishlatishda shart emas) ---
WEBHOOK_URL=https://your-cloudflare-tunnel.trycloudflare.com

# --- Admin Panel ---
ADMIN_SECRET_KEY=supersecretkey_change_me

# --- Ma'lumotlar bazasi ---
DATABASE_URL=sqlite:///./zeytun.db
# PostgreSQL uchun: DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

# --- AWS S3 / Cloudflare R2 ---
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL_S3=https://your-endpoint.r2.cloudflarestorage.com
AWS_REGION_NAME=auto
AWS_BUCKET_NAME=your_bucket_name
PUBLIC_FILE_URL=https://your-public-files-url.com

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8877,https://your-domain.com
